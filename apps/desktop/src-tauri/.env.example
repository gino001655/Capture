CAPTURE_API_BASE_URL=http://localhost:3000
CAPTURE_DEVICE_TOKEN=<same-at-least-32-character-token-as-the-server>
CAPTURE_AI_PROVIDER=codex-cli
# Optional: leave blank to use the Codex CLI default model.
CAPTURE_AI_MODEL=
# Explicit opt-ins. Keep false until the matching local app is configured and tested.
CAPTURE_JOURNAL_AI_ENABLED=false
CAPTURE_ANKI_ENABLED=false
CAPTURE_ANKI_CONNECT_URL=http://127.0.0.1:8765
CAPTURE_ANKI_DECK=English
CAPTURE_TODO_ENABLED=false
CAPTURE_TODO_CARD_ID=<heptabase-note-card-uuid>
CAPTURE_DESKTOP_REMINDERS_ENABLED=false
