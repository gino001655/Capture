{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Capture",
  "version": "0.3.1",
  "identifier": "com.personalcapture.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Personal Capture Worker",
        "width": 560,
        "height": 540,
        "resizable": false
      },
      {
        "label": "capture",
        "title": "Quick Capture",
        "width": 380,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
