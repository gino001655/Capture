import assert from "node:assert/strict";
import test from "node:test";
import { createFoodLibraryHandler } from "./route.ts";
const entry = { id: "11111111-1111-4111-8111-111111111111", name: "燕麥", quantity: 50, unit: "g", calories: 190, proteinGrams: 6, order: 0, archived: false };
const current = { id: "food:library" as const, moduleId: "food" as const, payload: { schemaVersion: 1 as const, entries: [entry] }, revision: 0, createdAt: "2026-09-08T00:00:00Z", updatedAt: "2026-09-08T00:00:00Z" };
test("historically used food can be archived but not deleted", async () => { let saves = 0; const handler = createFoodLibraryHandler({ async get() { return current; }, async save(input) { saves += 1; return { kind: "updated" as const, record: { ...current, payload: input.payload, revision: 1 } }; } }, { async list() { return [{ id: "food:2026-09-08", moduleId: "food" as const, journalDate: "2026-09-08", payload: { schemaVersion: 1 as const, calorieTarget: 2000, proteinTargetGrams: 120, entries: [{ ...entry, libraryEntryId: entry.id, note: "", occurredAt: "2026-09-08T00:00:00Z" }] }, revision: 0, processingState: "pending" as const, createdAt: "2026-09-08T00:00:00Z", updatedAt: "2026-09-08T00:00:00Z", lockedAt: null }]; } }, async () => ({ status: "authorized" as const })); const request = (entries: typeof current.payload.entries) => new Request("http://capture.test/api/special-records/food/library", { method: "PUT", headers: { "content-type": "application/json" }, body: JSON.stringify({ payload: { schemaVersion: 1, entries }, expectedRevision: 0 }) }); assert.equal((await handler(request([]))).status, 409); assert.equal((await handler(request([{ ...entry, archived: true }]))).status, 200); assert.equal(saves, 1); });
