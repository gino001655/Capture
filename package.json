{
  "name": "capture",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @capture/web dev",
    "desktop:dev": "pnpm --filter @capture/desktop tauri dev",
    "build": "pnpm --filter @capture/web build",
    "desktop:build": "pnpm --filter @capture/desktop tauri build",
    "create:recorder": "node scripts/create-recorder.mjs",
    "lint": "pnpm --filter @capture/web lint",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @capture/recorder-kit test && pnpm --filter @capture/web test && pnpm --filter @capture/desktop test",
    "typecheck": "pnpm --filter @capture/web typecheck && pnpm --filter @capture/desktop typecheck"
  }
}
